# Application Mode: 'mock' (deterministic offline testing/demo) or 'live' (real Zoho API)
APP_MODE=mock

# Zoho Inventory Organization ID (Numeric ID of the merchant organization)
ZOHO_ORGANIZATION_ID=1000000001

# Zoho OAuth 2.0 Client Credentials (from Zoho Developer Console)
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here

# Permanent OAuth Refresh Token (generated with ZohoInventory.items.READ, ZohoInventory.salesorders.READ, ZohoInventory.contacts.READ)
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here

# Zoho Base URL (Depends on Zoho data center region)
# US: https://www.zohoapis.com/inventory/v1
# EU: https://www.zohoapis.eu/inventory/v1
# IN: https://www.zohoapis.in/inventory/v1
# AU: https://www.zohoapis.com.au/inventory/v1
# JP: https://www.zohoapis.jp/inventory/v1
# CA: https://www.zohoapis.ca/inventory/v1
ZOHO_BASE_URL=https://www.zohoapis.com/inventory/v1

# Zoho Accounts URL for OAuth token refresh (optional; auto-detected if omitted)
# US: https://accounts.zoho.com
# EU: https://accounts.zoho.eu
# IN: https://accounts.zoho.in
# AU: https://accounts.zoho.com.au
# JP: https://accounts.zoho.jp
# CA: https://accounts.zoho.ca
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Resilience and Rate Limiting
# Zoho allows 100 req/min; we set default to 60 req/min for safety headroom
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=5
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=15.0

# Context Window Protection
MAX_PAGE_SIZE=50
DEFAULT_PAGE_SIZE=10
MAX_RESPONSE_BYTES=65536

# Observability
LOG_LEVEL=INFO
